APOLLO_API_KEY=your_apollo_api_key_here
APOLLO_BASE_URL=https://api.apollo.io/api/v1
# Optional. Leave empty unless Apollo provides/enables a credit balance endpoint for your account.
APOLLO_CREDITS_PATH=
# Optional. Required by Apollo only when enabling waterfall email enrichment.
APOLLO_WEBHOOK_URL=
# Match the working Globby behavior: only select people Apollo marks as having verified email.
# Leave empty to disable this People Search filter.
APOLLO_PEOPLE_SEARCH_EMAIL_STATUSES=verified
# If bulk enrichment returns no email, try the single-person People Enrichment endpoint too.
APOLLO_SINGLE_ENRICH_FALLBACK=true
# Your API key cannot access /webhook_result/show, so leave polling disabled and import webhook.site JSON instead.
APOLLO_WATERFALL_POLL_ATTEMPTS=0
APOLLO_WATERFALL_POLL_DELAY_SECONDS=10
APOLLO_WEBHOOK_WAIT_SECONDS=60
APOLLO_WEBHOOK_POLL_INTERVAL_SECONDS=5
